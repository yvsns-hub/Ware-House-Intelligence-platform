// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                    String                 @id @default(cuid())
  sku                   String                 @unique
  name                  String
  category              String
  description           String?
  stock                 Int                    @default(0)
  reservedStock         Int                    @default(0)
  damagedStock          Int                    @default(0)
  reorderLevel          Int                    @default(15)
  supplier              String
  warehouseLocation     String
  warehouseId           String?                @default("hub-01")
  imageUrl              String?
  unitPrice             Float
  demandScore           Float                  @default(5.0)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  orderItems            OrderItem[]
  inventoryTransactions InventoryTransaction[]

  @@index([category])
  @@index([sku])
  @@index([warehouseLocation])
  @@index([warehouseId])
}

model Order {
  id               String      @id @default(cuid())
  orderNumber      String      @unique
  customerName     String
  customerTier     String      // Platinum, Gold, Silver, Standard
  priority         String      // URGENT, HIGH, MEDIUM, LOW
  shippingType     String      // Express, SameDay, Standard, Freight
  deliveryDeadline DateTime
  orderValue       Float
  status           String      // PENDING, PROCESSING, PICKED, PACKED, SHIPPED, DELIVERED, CANCELLED
  totalItems       Int
  createdAt        DateTime    @default(now())
  items            OrderItem[]

  @@index([status])
  @@index([priority])
  @@index([customerTier])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  productId         String
  quantity          Int
  allocatedQuantity Int      @default(0)
  status            String   // ALLOCATED, PARTIALLY_ALLOCATED, BACKORDERED, PICKED, PACKED
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model WarehouseEmployee {
  id              String   @id @default(cuid())
  name            String
  role            String   // Picker, Packer, Supervisor
  efficiencyScore Float    // e.g., 0.0 to 100.0 or 0.85 to 1.25 multiplier
  activeOrders    Int      @default(0)
  shift           String   // Morning, Evening, Night

  @@index([role])
  @@index([shift])
}

model WarehouseLocation {
  id    String @id @default(cuid())
  aisle String
  rack  String
  shelf String
  zone  String // Cold Storage, High Value, Bulk Cargo, Fast Moving, Standard

  @@index([zone])
  @@index([aisle, rack, shelf])
}

model InventoryTransaction {
  id        String   @id @default(cuid())
  productId String
  quantity  Int
  type      String   // Inbound, Outbound, Damaged, Adjusted, Transferred
  timestamp DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([type])
  @@index([timestamp])
}
